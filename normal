const radius = [3,1,2,4];

const caluculateArea = function (radius){
    const output = [];
    for(let i = 0 ; i< radius.length ; i++){
        output.push(Math.PI * radius[i] * radius[i]);
    }
    return output ;

};
var  area = caluculateArea(radius);
console.log(area);

const caluculatecircu = function (radius){
    const output = [];
    for(let i = 0 ; i< radius.length ; i++){
        output.push( 2 *Math.PI * radius[i] * radius[i]);
    }
    return output ;

};
console.log(caluculatecircu(radius));

const diameter = function (radius){
    const output = [];
    for(let i = 0 ; i< radius.length ; i++){
        output.push( 2   * radius[i]);
    }
    return output ;

};
console.log(diameter(radius));
